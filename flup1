def escribir_como_humano(consola, texto, delay=0.03):
    for char in texto:
        consola.send(char)
        sys.stdout.write(char)
        sys.stdout.flush()
        time.sleep(delay)
    consola.sendline("")  # Simula Enter
    print()  # Salto de línea en consola visual

