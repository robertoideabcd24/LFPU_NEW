#!/usr/bin/env python3
import sys
import os
from lexer import Lexer
from parser import Parser, Asignacion, Numero, OperacionBinaria, Variable
from interprete import Interpreter

# Función para imprimir el árbol de sintaxis
def imprimir_arbol_sintaxis(nodes):
    if not isinstance(nodes, list):
        nodes = [nodes]  # Convierte nodo individual en lista
        
    print("\nÁrbol de Sintaxis Abstracta (AST):")
    for i, node in enumerate(nodes):
        es_ultimo = (i == len(nodes) - 1)
        _imprimir_nodo(node, "", es_ultimo)

def _imprimir_nodo(node, prefijo, es_ultimo):
    marcador = "└── " if es_ultimo else "├── "
    print(prefijo + marcador, end="")
    
    if isinstance(node, Asignacion):
        print(f"Asignacion({node.nombre_var} = {node.valor})")
        nuevo_prefijo = prefijo + ("    " if es_ultimo else "│   ")
        _imprimir_nodo(node.valor, nuevo_prefijo, True)
    elif isinstance(node, OperacionBinaria):
        print(f"OperacionBinaria({node.izquierda} {node.operador} {node.derecha})")
        nuevo_prefijo = prefijo + ("    " if es_ultimo else "│   ")
        _imprimir_nodo(node.izquierda, nuevo_prefijo, False)
        _imprimir_nodo(node.derecha, nuevo_prefijo, True)
    elif isinstance(node, (Numero, Variable)):
        print(f"{node.__class__.__name__}({node.valor if isinstance(node, Numero) else node.nombre})")

def ejecutar_archivo(archivo_flup, debug=False):
    """Carga y ejecuta un archivo .flup"""
    if not os.path.exists(archivo_flup):
        print(f"\033[91mError:\033[0m No se encontró '{archivo_flup}'")
        return

    try:
        # Leer contenido del archivo
        with open(archivo_flup, 'r') as f:
            contenido = f.read().strip()

        # Tokenizar el contenido
        lexer = Lexer(contenido)  # Pasar el flag debug al lexer
        lexer.debug = debug 
        tokens = lexer.tokenizar()
        
        if debug:
            print("\nTokens identificados:", tokens)

        # Analizar los tokens
        parser = Parser(tokens)
        ast = parser.analizar()

        # Mostrar el árbol de sintaxis abstracta solo en modo debug
        if debug:
            print("\nÁrbol de Sintaxis Abstracta (AST):")
            imprimir_arbol_sintaxis(ast[0]) if ast else print("No hay declaraciones para analizar")

        # Ejecutar el AST
        interprete = Interpreter()
        resultado = interprete.ejecutar(ast, debug)  # Pasar el flag debug al intérprete

        if debug:
            print(f"\nResultado de la ejecución de {archivo_flup}: {resultado}")
            print("\nEstado de la memoria después de la ejecución:")
            interprete.imprimir_memoria()
        else:
            # Solo mostrar resultados en modo silencioso
            interprete.imprimir_memoria()

    except Exception as e:
        print(f"\n\033[91mERROR:\033[0m {str(e)}")
        if debug:
            import traceback
            traceback.print_exc()

    if debug:
        print("\n----- Ejecución completada -----")

def main():
    if len(sys.argv) < 2:
        print("Uso: flup [ast] <archivo1.flup> [archivo2.flup ...]")
        print("  ast - Muestra información detallada de tokens y AST")
        return

    # Verificar si el primer argumento es 'ast'
    show_debug = False
    file_args = sys.argv[1:]
    
    if sys.argv[1].lower() == 'ast':
        show_debug = True
        file_args = sys.argv[2:]  # Remover el argumento 'ast'
    
    if not file_args:
        print("Error: Debes especificar al menos un archivo .flup")
        return

    for archivo in file_args:
        if show_debug:
            print(f"Ejecutando {archivo}...")
        ejecutar_archivo(archivo, show_debug)

if __name__ == '__main__':
    main()
