# Función para imprimir el árbol de sintaxis
def imprimir_arbol_sintaxis(nodes):
    if not nodes:  # Si no hay nodos
        print("(Árbol vacío)")
        return
        
    if not isinstance(nodes, list):
        nodes = [nodes]
        
    print("\nÁrbol de Sintaxis Abstracta (AST):")
    for i, node in enumerate(nodes):
        es_ultimo = (i == len(nodes) - 1)
        _imprimir_nodo(node, "", es_ultimo)

def _imprimir_nodo(node, prefijo, es_ultimo):
    marcador = "└── " if es_ultimo else "├── "
    print(prefijo + marcador, end="")
    
    if isinstance(node, Asignacion):
        print(f"Asignacion({node.nombre_var} = ...)")
        nuevo_prefijo = prefijo + ("    " if es_ultimo else "│   ")
        _imprimir_nodo(node.valor, nuevo_prefijo, True)
    elif isinstance(node, OperacionBinaria):
        print(f"OperacionBinaria({node.operador})")
        nuevo_prefijo = prefijo + ("    " if es_ultimo else "│   ")
        _imprimir_nodo(node.izquierda, nuevo_prefijo, False)
        _imprimir_nodo(node.derecha, nuevo_prefijo, True)
    elif isinstance(node, Numero):
        print(f"Numero({node.valor})")
    elif isinstance(node, Variable):
        print(f"Variable({node.nombre})")
    elif isinstance(node, Cadena):
        print(f"Cadena('{node.valor}')")
    elif isinstance(node, Prt):
        print(f"Prt(...)")
        nuevo_prefijo = prefijo + ("    " if es_ultimo else "│   ")
        _imprimir_nodo(node.expresion, nuevo_prefijo, True)
    else:
        print(f"Tipo de nodo desconocido: {type(node)}")


def modo_interactivo():
    """Modo consola interactiva mejorado"""
    print(f"{Colors.TITULO}Bienvenido a FLUP v1.0 - Modo interactivo{Colors.RESET}")
    #print(f"Escribe {Colors.EXITO}exit{Colors.RESET} para terminar")
    #print(f"Presiona {Colors.EXITO}Enter dos veces{Colors.RESET} para mostrar variables\n")
    
    interprete = Interpreter()
    empty_line_count = 0  # Contador de líneas vacías
    
    while True:
        try:
            entrada = input(f"{Colors.VARIABLE}flup>{Colors.RESET} ").strip()
            
            if entrada.lower() == 'exit':
                break
                
            if not entrada:
                empty_line_count += 1
                if empty_line_count >= 2:  # Doble Enter
                    print(f"\n{Colors.TITULO}=== Memoria ==={Colors.RESET}")
                    interprete.imprimir_memoria()
                    #print()  # Salto de línea adicional
                    empty_line_count = 0
                continue
            else:
                empty_line_count = 0  # Resetear contador si hay entrada
                
            # Procesar entrada
            lexer = Lexer(entrada)
            tokens = lexer.tokenizar()
            parser = Parser(tokens)
            ast = parser.analizar()
            
            # Ejecutar y mostrar resultado individual si hay
            resultado = interprete.ejecutar(ast, debug=False)
            
            #if resultado is not None:
            #    print()
                #print(f"  $~ {Colors.NUMERO}{resultado}{Colors.RESET}")
                
        except Exception as e:
            print(f"{Colors.FAIL}Error: {str(e)}{Colors.RESET}")
            empty_line_count = 0

def aplicar_colores(texto):
    """Aplica colores a los elementos del código"""
    # Tokenizar el texto para identificar elementos
    lexer = Lexer(texto)
    tokens = lexer.tokenizar()
    
    resultado = []
    for token_type, token_value in tokens:
        if token_type == 'ID':
            resultado.append(f"{Colors.VARIABLE}{token_value}{Colors.RESET}")
        elif token_type in ('ENTERO', 'FLOTANTE'):
            resultado.append(f"{Colors.NUMERO}{token_value}{Colors.RESET}")
        elif token_type in ('SUMA', 'RESTA', 'MULT', 'DIV'):
            resultado.append(f"{Colors.OPERADOR}{token_value}{Colors.RESET}")
        elif token_type == 'ASIGNACION':
            resultado.append(f"{Colors.ASIGNACION}{token_value}{Colors.RESET}")
        else:
            resultado.append(token_value)
    
    return ' '.join(resultado)

def modo_script(archivo, debug=False):
    """Ejecutar un archivo script"""
    if not os.path.exists(archivo):
        print(f"{Colors.FAIL}Error:{Colors.RESET} Archivo no encontrado")
        return

    try:
        with open(archivo, 'r') as f:
            contenido = f.read()

        if debug:
            print(f"\n{Colors.TITULO}=== Contenido del archivo ==={Colors.RESET}")
            print(contenido)
            print(f"{Colors.TITULO}============================{Colors.RESET}")

        lexer = Lexer(contenido, debug=debug)
        tokens = lexer.tokenizar()
        
        if debug:
            print(f"\n{Colors.CYAN}=== Tokens identificados ==={Colors.RESET}")
            for i, (token_type, token_value) in enumerate(tokens, 1):
                color = ""
                if token_type == 'ID': color = Colors.VARIABLE
                elif token_type in ('ENTERO', 'FLOTANTE'): color = Colors.NUMERO
                elif token_type in ('SUMA', 'RESTA', 'MULT', 'DIV'): color = Colors.OPERADOR
                elif token_type == 'ASIGNACION': color = Colors.ASIGNACION
                
                print(f"  {i:2d}. {color}{token_type:12s}{Colors.RESET}: {token_value}")
        
        parser = Parser(tokens)
        ast = parser.analizar()
        
        if debug:
            print(f"\n{Colors.CYAN}=== Árbol de Sintaxis Abstracta ==={Colors.RESET}")
            imprimir_arbol_sintaxis(ast)
        
        interprete = Interpreter()
        interprete.ejecutar(ast, debug=debug)
        
        #print(f"\n{Colors.CYAN}=== Estado final de variables ==={Colors.RESET}")
        interprete.imprimir_memoria()
        
    except Exception as e:
        print(f"{Colors.FAIL}ERROR:{Colors.RESET} {str(e)}")
        if debug:
            import traceback
            traceback.print_exc()

def main():
    try:
        if len(sys.argv) == 1:
            modo_interactivo()
        elif len(sys.argv) == 2 and sys.argv[1] == 'v1':
            modo_interactivo()
        elif len(sys.argv) == 2:
            modo_script(sys.argv[1])
        elif len(sys.argv) == 3 and sys.argv[1] == 'ast':
            modo_script(sys.argv[2], debug=True)
        else:
            print("Uso:")
            print("  flup v1          - Modo interactivo")
            print("  flup script.flup - Ejecutar archivo")
            print("  flup ast script.flup - Modo depuración")
    except KeyboardInterrupt:
        print("\nEjecución interrumpida por el usuario")
    except Exception as e:
        print(f"\n{Colors.FAIL}Error inesperado:{Colors.RESET} {str(e)}")

if __name__ == '__main__':
    main()